<Window x:Class="Icarus_Drone_Service_Software.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Icarus_Drone_Service_Software"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1013">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="21" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True">
                <DockPanel Margin="5" LastChildFill="False" DockPanel.Dock="Bottom">
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="False">
                            <Label DockPanel.Dock="Top" FontWeight="Bold">Service Cost</Label>
                            <TextBox Margin="5" DockPanel.Dock="Top" x:Name="TbxServiceCost" />
                            <Label DockPanel.Dock="Top" FontWeight="Bold">Service Tag</Label>
                            <xctk:IntegerUpDown DockPanel.Dock="Top" Margin="5" x:Name="IudServiceTag" AllowSpin="False" AllowTextInput="False" Minimum="100" Maximum="900" Increment="10" Value="100"/>

                        </DockPanel>
                        <DockPanel Grid.Column="1" LastChildFill="False">
                            <Label DockPanel.Dock="Top" FontWeight="Bold">Service Type</Label>
                            <DockPanel DockPanel.Dock="Top">
                                <RadioButton x:Name="RbtRegular" DockPanel.Dock="Left" Content="Regular" Margin="5" IsChecked="True" GroupName="Priority"/>
                                <RadioButton x:Name="RbtExpress" DockPanel.Dock="Left" Content="Express" Margin="5" GroupName="Priority" />
                                
                            </DockPanel>
                            <Button x:Name="BtnSubmit" Margin="5" DockPanel.Dock="Bottom" Click="AddNewItem">Submit</Button>
                        </DockPanel>
                    </Grid>
                    
                </DockPanel>
                <DockPanel Margin="5" LastChildFill="True" DockPanel.Dock="Top">
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" LastChildFill="False">
                            <Label DockPanel.Dock="Top" FontWeight="Bold">Client Name</Label>
                            <TextBox Margin="5" DockPanel.Dock="Top" x:Name="TbxClientName" />
                        </DockPanel>
                        <DockPanel Grid.Column="1" LastChildFill="False">
                            <Label DockPanel.Dock="Top" FontWeight="Bold">Drone Model</Label>
                            <TextBox Margin="5" DockPanel.Dock="Top" x:Name="TbxDroneModel"/>
                        </DockPanel>
                    </Grid>
                    <DockPanel DockPanel.Dock="Top">
                        <Label DockPanel.Dock="Top" FontWeight="Bold">Service Problem</Label>
                        <TextBox x:Name="TbxServiceProblem" DockPanel.Dock="Top" Margin="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ></TextBox>

                    </DockPanel>
                </DockPanel>
            </DockPanel>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <DockPanel LastChildFill="True" Grid.Column="0" Margin="5">
                    <Label DockPanel.Dock="Top" FontWeight="Bold">Regular Queue</Label>
                    <Button x:Name="BtnProcessRegular"  Margin="5" DockPanel.Dock="Bottom" Click="BtnProcessRegular_Click">Process Next in Queue</Button>
                    <ListView x:Name="LvwRegular" Margin="5" DockPanel.Dock="Top" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="LvwRegular_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tag" DisplayMemberBinding="{Binding ServiceTag}"/>
                                <GridViewColumn Header="Client Name" DisplayMemberBinding= "{Binding ClientName}"/>
                                <GridViewColumn Header="Model" DisplayMemberBinding= "{Binding DroneModel}"/>
                                <GridViewColumn Header="Problem" DisplayMemberBinding= "{Binding ServiceProblem}"/>
                                <GridViewColumn Header="Cost" DisplayMemberBinding="{Binding ServiceCost, StringFormat='${0:F2}'}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                <DockPanel LastChildFill="True" Grid.Column="1" Margin="5">
                    <Label DockPanel.Dock="Top" FontWeight="Bold">Express Queue</Label>
                    <Button x:Name="BtnProcessExpress"  Margin="5" DockPanel.Dock="Bottom" Click="BtnProcessExpress_Click">Process Next in Queue</Button>
                    <ListView x:Name="LvwExpress" Margin="5" DockPanel.Dock="Top" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="LvwExpress_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tag" DisplayMemberBinding="{Binding ServiceTag}"/>
                                <GridViewColumn Header="Client Name" DisplayMemberBinding= "{Binding ClientName}"/>
                                <GridViewColumn Header="Model" DisplayMemberBinding= "{Binding DroneModel}"/>
                                <GridViewColumn Header="Problem" DisplayMemberBinding= "{Binding ServiceProblem}"/>
                                <GridViewColumn Header="Cost" DisplayMemberBinding="{Binding ServiceCost, StringFormat='${0:F2}'}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
                
            </Grid>
            <DockPanel Grid.Column="2" Margin="5" LastChildFill="True">
                <Label DockPanel.Dock="Top" FontWeight="Bold">Finished Items</Label>
                <ListBox x:Name="LbxFinished" Margin="5" DockPanel.Dock="Top" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="LbxFinished_MouseDoubleClick"></ListBox>
            </DockPanel>


        </Grid>
        <StatusBar x:Name="SbrStatus" Grid.Row="1"/>
    </Grid>
    
</Window>
